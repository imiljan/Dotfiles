ppLogs() {
  jq -Rr 'try (fromjson | select(.severity) | "\(.timestamp.seconds | todate) [\(.severity)] \(.message | if type == "object" then (to_entries | map("\(.key)=\(.value)") | join(" ")) else . end)")'
}

