export-vars() {
  if [ -f "$1" ]; then
    while IFS='=' read -r key value; do
      # Skip empty lines or lines where the key is empty
      if [ -n "$key" ] && [ -n "$value" ]; then
        export "$key=$value"
      fi
    done <"$1"
  else
    echo "File not found: $1"
  fi
}

