# Cloud Run
deploy() {
  local env="$1"
  if [[ "$env" != "staging" && "$env" != "qa" && "$env" != "test" && "$env" != "prod" ]]; then
    echo "Usage: deploy <staging|qa|test|prod>"
    return 1
  fi

  gh workflow run 'Cloud Run Deployment' \
    -f deploy_environment="$env"
}

deploy-br() {
  local env="$1"
  if [[ "$env" != "staging" && "$env" != "qa" ]]; then
    echo "Usage: deploy-br <staging|qa>"
    return 1
  fi

  gh workflow run 'Cloud Run Deployment' \
    --ref "$(git rev-parse --abbrev-ref HEAD)" \
    -f deploy_environment="$env"
}

deploy-prerelease() {
  gh workflow run 'Cloud Run Deployment' -f deploy_environment=staging
  gh workflow run 'Cloud Run Deployment' -f deploy_environment=qa
  gh workflow run 'Cloud Run Deployment' -f deploy_environment=test
}

deploy-release() {
  gh workflow run 'Cloud Run Deployment' -f deploy_environment=staging
  gh workflow run 'Cloud Run Deployment' -f deploy_environment=qa
  gh workflow run 'Cloud Run Deployment' -f deploy_environment=test
  gh workflow run 'Cloud Run Deployment' -f deploy_environment=prod
}

# Cloud functions
cloud-func() {
  local env="$1"
  if [[ "$env" != "staging" && "$env" != "qa" && "$env" != "test" && "$env" != "prod" ]]; then
    echo "Usage: cloud-func <staging|qa|test|prod> <function_name>"
    return 1
  fi

  local function_name="$2"
  if [[ -z "$function_name" ]]; then
    echo "Usage: cloud-func <staging|qa|test|prod> <function_name>"
    echo "For multiple functions: cloud-func <staging|qa|test|prod> <function_name>,functions:<function_name>"
    return 1
  fi

  gh workflow run 'Deploy Firebase Cloud Function' \
    -f deploy_environment="$env" \
    -f function_name="$function_name"
}

cloud-func-br() {
  local env="$1"
  if [[ "$env" != "staging" && "$env" != "qa" ]]; then
    echo "Usage: cloud-func-br <staging|qa|test|prod> <function_name>"
    return 1
  fi

  local function_name="$2"
  if [[ -z "$function_name" ]]; then
    echo "Usage: cloud-func-br <staging|qa|test|prod> <function_name>"
    echo "For multiple functions: cloud-func-br <staging|qa|test|prod> <function_name>,functions:<function_name>"
    return 1
  fi

  gh workflow run 'Deploy Firebase Cloud Function' \
    --ref $(git rev-parse --abbrev-ref HEAD) \
    -f deploy_environment="$env" \
    -f function_name="$function_name"
}

cloud-func-release() {
  local function_name="$1"
  if [[ -z "$function_name" ]]; then
    echo "Usage: cloud-func-release <function_name>"
    echo "For multiple functions: cloud-func-release <function_name>,functions:<function_name>"
    return 1
  fi

  gh workflow run 'Deploy Firebase Cloud Function' -f deploy_environment=staging -f function_name="$function_name"
  gh workflow run 'Deploy Firebase Cloud Function' -f deploy_environment=qa -f function_name="$function_name"
  gh workflow run 'Deploy Firebase Cloud Function' -f deploy_environment=test -f function_name="$function_name"
  gh workflow run 'Deploy Firebase Cloud Function' -f deploy_environment=prod -f function_name="$function_name"
}

